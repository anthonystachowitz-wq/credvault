// ============================================================================
// Equality Proof - studentId
// Proves that hash(studentId) == expectedHash without revealing the actual value
// Uses persistentHash for on-chain verifiable hashing
// ============================================================================
export circuit verifyStudentIdEquals(expectedHash: Bytes<32>): [] {
  const actualValue = studentIdValue();
  // Hash the actual value and compare to expected
  const actualHash = persistentHash<[Bytes<256>]>([actualValue]);
  assert(actualHash == expectedHash, "studentId value does not match");
}

// ============================================================================
// Knowledge Proof - studentId
// Proves knowledge of studentId without revealing the value
// Returns a commitment/hash that can be verified off-chain
// Uses disclose() to explicitly mark the hash as public output
// ============================================================================
export circuit proveStudentIdKnowledge(): Bytes<32> {
  const actualValue = studentIdValue();
  // Hash the witness value and explicitly disclose the result
  const hashResult = persistentHash<[Bytes<256>]>([actualValue]);
  return disclose(hashResult);
}

// ============================================================================
// Sparse Hash At Level - Computes hash at a specific level for sparse Merkle proof
// ============================================================================
circuit sparseHashAtLevel(
  currentHash: Bytes<32>,
  sibling: Bytes<32>,
  isRight: Boolean
): Bytes<32> {
  const left = isRight ? sibling : currentHash;
  const right = isRight ? currentHash : sibling;
  return hashPair(left, right);
}

