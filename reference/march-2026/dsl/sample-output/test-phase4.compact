// Sparse Merkle proof structure for non-existence verification
// Depth: 32 levels (supports 2^32 possible revocation entries)
export struct SparseMerkleProof {
  siblings: Vector<32, Bytes<32>>,
  isRight: Vector<32, Boolean>,
