// ============================================
// CredVault Transcript Verification Contract
// With Merkle proof verification and ZK range proofs
// Using Commitment Pattern for GPA Privacy
// ============================================

pragma language_version 0.21;

import CompactStandardLibrary;

// ============================================
// LEDGER: On-chain state (public)
// ============================================

// The Merkle root of the transcript
export ledger merkleRoot: Bytes<32>;

// SOT attestation signature
export ledger sotAttestation: Bytes<32>;

// Issue timestamp
export ledger issuedAt: Uint<64>;

// GPA commitment (hash of GPA + salt) - allows private GPA verification
export ledger gpaCommitment: Bytes<32>;

// ============================================
// CONSTRUCTOR
// ============================================

constructor(root: Bytes<32>, attestation: Bytes<32>, gpaCommit: Bytes<32>) {
  merkleRoot = disclose(root);
  sotAttestation = disclose(attestation);
  gpaCommitment = disclose(gpaCommit);
  issuedAt = 0;
}

// ============================================
// HELPER CIRCUITS
// ============================================

// Hash two bytes<32> values together
// Used for Merkle tree operations
circuit hashPair(left: Bytes<32>, right: Bytes<32>): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>]>([left, right]);
}

// ============================================
// MERKLE PROOF VERIFICATION
// ============================================

// Verify a Merkle proof with 4 siblings (fixed size for simplicity)
export circuit verifyMerkleProof4(
  leafHash: Bytes<32>,
  siblings: Vector<4, Bytes<32>>,
  isRight: Vector<4, Boolean>
): Boolean {
  // Level 0
  const sibling0 = siblings[0];
  const isRight0 = isRight[0];
  const left0 = isRight0 ? sibling0 : leafHash;
  const right0 = isRight0 ? leafHash : sibling0;
  const hash0 = hashPair(left0, right0);
  
  // Level 1
  const sibling1 = siblings[1];
  const isRight1 = isRight[1];
  const left1 = isRight1 ? sibling1 : hash0;
  const right1 = isRight1 ? hash0 : sibling1;
  const hash1 = hashPair(left1, right1);
  
  // Level 2
  const sibling2 = siblings[2];
  const isRight2 = isRight[2];
  const left2 = isRight2 ? sibling2 : hash1;
  const right2 = isRight2 ? hash1 : sibling2;
  const hash2 = hashPair(left2, right2);
  
  // Level 3
  const sibling3 = siblings[3];
  const isRight3 = isRight[3];
  const left3 = isRight3 ? sibling3 : hash2;
  const right3 = isRight3 ? hash2 : sibling3;
  const hash3 = hashPair(left3, right3);
  
  // Verify against stored root
  return hash3 == merkleRoot;
}

// ============================================
// ZK RANGE PROOFS WITH COMMITMENT
// ============================================

// Witnesses: Provide the actual GPA and salt separately (kept private)
// The student provides these values locally to generate proofs
witness gpaValue(): Uint<32>;
witness gpaSalt(): Bytes<32>;

// Helper circuit to verify commitment
// The commitment is computed off-chain and stored on-chain
// This circuit verifies the witness values match the commitment
circuit verifyCommitment(gpa: Uint<32>, salt: Bytes<32>): Boolean {
  // For simplicity, we use a direct comparison approach
  // In production, this would be a proper hash verification
  // The commitment is: hash(gpa || salt)
  // We verify by checking the hash matches
  
  // Convert GPA to bytes (4 bytes for Uint<32>)
  // Then hash with salt
  const gpaAsField = gpa as Field;
  const commitmentCheck = persistentHash<[Field, Bytes<32>]>([gpaAsField, salt]);
  
  // Return true if commitment matches
  return commitmentCheck == gpaCommitment;
}

// Verify that a user's GPA is >= minGpa without revealing the actual GPA
// Uses commitment pattern: proves knowledge of GPA that matches commitment
export circuit verifyMinGPA(minGpa: Uint<32>): Boolean {
  // Get private GPA and salt from witnesses
  const actualGpa = gpaValue();
  const salt = gpaSalt();
  
  // Verify the commitment matches (proves knowledge of GPA without revealing it)
  const isValidCommitment = verifyCommitment(actualGpa, salt);
  assert(isValidCommitment, "Invalid GPA commitment");
  
  // Verify GPA meets minimum requirement
  assert(actualGpa >= minGpa, "GPA below minimum");
  
  return true;
}

// Verify GPA is within a specific range [minGpa, maxGpa]
export circuit verifyGpaRange(minGpa: Uint<32>, maxGpa: Uint<32>): Boolean {
  // Get private GPA and salt from witnesses
  const actualGpa = gpaValue();
  const salt = gpaSalt();
  
  // Verify the commitment matches
  const isValidCommitment = verifyCommitment(actualGpa, salt);
  assert(isValidCommitment, "Invalid GPA commitment");
  
  // Verify both bounds
  assert(actualGpa >= minGpa, "GPA below minimum");
  assert(actualGpa <= maxGpa, "GPA above maximum");
  
  return true;
}

// ============================================
// BASIC CIRCUITS
// ============================================

// Update the Merkle root (for amendments)
export circuit updateRoot(newRoot: Bytes<32>): [] {
  merkleRoot = disclose(newRoot);
}

// Get current Merkle root
export circuit getRoot(): Bytes<32> {
  return merkleRoot;
}

// Update GPA commitment (for SOT to update if needed)
export circuit updateGpaCommitment(newCommitment: Bytes<32>): [] {
  gpaCommitment = disclose(newCommitment);
}

// Get current GPA commitment
export circuit getGpaCommitment(): Bytes<32> {
  return gpaCommitment;
}
