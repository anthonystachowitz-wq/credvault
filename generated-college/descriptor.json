{
  "descriptorType": "credvault-descriptor/1.0",
  "schemaId": "college-degree",
  "schemaVersion": "0.3",
  "displayName": "Penn State University",
  "issuerType": "university",
  "display": {
    "icon": "🎓",
    "cardTitle": "{{fields.fullName}}",
    "cardSubtitle": "{{issuer.displayName}} · {{cohort}}",
    "verifyTitle": "{{fields.fullName}}",
    "verifySubtitle": "college-degree"
  },
  "fields": [
    {
      "kind": "value",
      "name": "fullName",
      "label": "Full Name",
      "type": "string",
      "scheme": "canonical-field/v1",
      "disclosable": [
        "reveal"
      ],
      "defaultDisclosure": "reveal"
    },
    {
      "kind": "value",
      "name": "degree",
      "label": "Degree",
      "type": "string",
      "scheme": "canonical-field/v1",
      "disclosable": [
        "reveal",
        "equality"
      ],
      "defaultDisclosure": "reveal"
    },
    {
      "kind": "metric",
      "name": "gpa",
      "label": "Gpa",
      "type": "uint",
      "scale": 100,
      "format": "x.xx",
      "scheme": "compact-commit-uint64/v1",
      "disclosable": [
        "reveal",
        "threshold",
        "range"
      ],
      "predicates": {
        "mechanism": "universal-range-v1",
        "operators": [
          "gte"
        ],
        "premint": [
          {
            "op": "gte",
            "value": 300
          },
          {
            "op": "gte",
            "value": 350
          }
        ]
      },
      "defaultDisclosure": "reveal"
    }
  ],
  "sets": [
    {
      "name": "courseGrades",
      "label": "Course Grades",
      "mode": "granular",
      "maxItems": 40,
      "itemScheme": "canonical-course-leaf/v0",
      "docScheme": "canonical-doc/v1",
      "canonicalSort": [
        "code"
      ],
      "itemFields": [
        {
          "name": "code",
          "label": "Code",
          "type": "string"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "string"
        },
        {
          "name": "credits",
          "label": "Credits",
          "type": "uint"
        },
        {
          "name": "grade",
          "label": "Grade",
          "type": "string"
        }
      ],
      "itemDisplay": "{{code}} — {{title}} — {{credits}} — {{grade}}"
    }
  ],
  "leafLayout": [
    "field:fullName",
    "field:degree",
    "field:gpa",
    "set:courseGrades"
  ],
  "issuerRuntime": {
    "mode": "batch",
    "revocationCadence": "batch",
    "novelProofs": "on-request"
  },
  "contract": {
    "template": "credvault-anchor-core/1",
    "predicateSupport": "universal-range-v1"
  },
  "fees": {
    "enabled": false
  }
}